#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        workplaces: workplaces {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp LC(RIGHT)>, <&kp LC(LEFT_ARROW)>;

            tap-ms = <100>;
            label = "WORKPLACES";
        };

        uptownbehavior: uptownbehavior {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp UP_ARROW>, <&kp DOWN_ARROW>;

            tap-ms = <100>;
            label = "UPTOWNBEHAVIOR";
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        spotlight_cmd4: spotlight_cmd4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(SPACE)>,
                <&macro_wait_time 50>,
                <&kp LG(NUMBER_4)>;

            label = "SPOTLIGHT_CMD4";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC         &kp N1    &kp N2  &kp N3            &kp N4        &kp N5          &kp UP_ARROW     &kp N6     &kp N7  &kp N8           &kp N9         &kp N0         &kp BACKSPACE
&kp TAB         &kp Q     &kp W   &kp E             &kp R         &kp T           &kp DOWN_ARROW   &kp Y      &kp U   &kp I            &kp O          &kp P          &kp LEFT_BRACKET
&kp LEFT_SHIFT  &kp A     &kp S   &kp D             &kp F         &kp G           &kp LEFT_ARROW   &kp H      &kp J   &kp K            &kp L          &kp SEMI       &kp APOS
&none           &kp Z     &kp X   &kp C             &kp V         &kp B           &kp RIGHT_ARROW  &kp N      &kp M   &kp COMMA        &kp DOT        &kp FSLH       &kp ENTER
&bt BT_NXT      &kp CAPS  &none   &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI    &kp ENTER        &kp SPACE  &mo 1   &kp RIGHT_SHIFT  &kp RIGHT_GUI  &kp RIGHT_ALT
            >;

            sensor-bindings = <&uptownbehavior>, <&rsr_trans>;

            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
&kp ESCAPE      &kp C_BRI_DEC  &kp C_BRI_INC  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp LG(SPACE)  &spotlight_cmd4    &mmv MOVE_UP     &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_DN  &kp C_VOLUME_UP  &trans
&kp TAB         &none          &none          &none                              &none          &none              &mmv MOVE_DOWN   &kp MINUS   &kp EQUAL         &kp UP      &trans        &trans           &kp RIGHT_BRACKET
&kp LEFT_SHIFT  &none          &none          &none                              &none          &none              &mmv MOVE_LEFT   &trans      &kp LEFT          &kp DOWN    &kp RIGHT     &kp GRAVE        &kp NON_US_BACKSLASH
&mo 2           &none          &none          &none                              &none          &none              &mmv MOVE_RIGHT  &none       &none             &none       &none         &none            &none
&none           &trans         &trans         &trans                             &trans         &trans             &mkp LCLK        &trans      &trans            &trans      &trans        &trans
            >;

            sensor-bindings = <&scroll_encoder>, <&rsr_trans>;

            display-name = "LAYER1";
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &bt BT_CLR    &trans  &bl BL_TOG  &trans  &trans  &trans  &trans  &soft_off
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans        &trans  &trans      &trans  &trans  &trans  &trans
            >;
        };
    };
};
